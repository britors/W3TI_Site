---
import ProductStatus from './ProductStatus.astro';
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class:list={['product-card', `accent--${product.accent}`]}>
  <div class="product-card__topline">
    <span class="product-symbol" aria-hidden="true">{product.symbol}</span>
    <ProductStatus status={product.status} />
  </div>
  <div class="product-card__body">
    <h3>{product.name}</h3>
    <p>{product.summary}</p>
  </div>
  {
    product.technologies && (
      <ul class="tag-list" aria-label={`Tecnologias relacionadas a ${product.name}`}>
        {product.technologies.map((technology) => (
          <li>{technology}</li>
        ))}
      </ul>
    )
  }
  {
    product.modalId ? (
      <button
        class="text-link product-card__action"
        type="button"
        data-modal-open={product.modalId}
        aria-controls={product.modalId}
      >
        Como instalar <span aria-hidden="true">→</span>
      </button>
    ) : product.url ? (
      <a class="text-link" href={product.url} target="_blank" rel="noopener noreferrer">
        Saiba mais <span aria-hidden="true">↗</span>
      </a>
    ) : null
  }
</article>
