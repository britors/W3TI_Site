---
import { siteConfig } from '../data/site';

const baseUrl = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="container site-footer__main">
    <div>
      <p>Produtos de software feitos para resolver problemas reais.</p>
    </div>
    <div class="site-footer__links">
      <a href={`${baseUrl}#produtos`}>Produtos</a>
      <a href={`${baseUrl}#empresa`}>Empresa</a>
      <a href={`${baseUrl}#contato`}>Contato</a>
      <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer"
        >GitHub <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
  <div class="container site-footer__bottom">
    <span>© {new Date().getFullYear()} W3TI</span>
    <span>Feito com cuidado no Brasil.</span>
  </div>
</footer>
