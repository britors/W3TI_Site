---
import { catalogProducts } from '../data/products';
import { siteConfig } from '../data/site';
import LogoMark from './LogoMark.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="container site-footer__main">
    <div class="site-footer__brand">
      <LogoMark />
      <p>Produtos de software feitos para resolver problemas reais.</p>
    </div>
    <nav class="site-footer__column" aria-label="Produtos">
      <p class="site-footer__heading">Produtos</p>
      {catalogProducts.map((product) => <a href={`${baseUrl}#produtos`}>{product.name}</a>)}
    </nav>
    <nav class="site-footer__column" aria-label="Empresa">
      <p class="site-footer__heading">Empresa</p>
      <a href={`${baseUrl}#em-desenvolvimento`}>Em desenvolvimento</a>
      <a href={`${baseUrl}#lyra`}>Lyra OS</a>
      <a href={`${baseUrl}#empresa`}>Sobre a W3TI</a>
    </nav>
    <div class="site-footer__column">
      <p class="site-footer__heading">Contato</p>
      <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
      <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer"
        >GitHub <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
  <div class="container site-footer__bottom">
    <span>© {new Date().getFullYear()} W3TI. Todos os direitos reservados.</span>
    <span>Feito no Brasil.</span>
  </div>
</footer>
