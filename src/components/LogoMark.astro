---
import { siteConfig } from '../data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<a
  class:list={['logo', { 'logo--compact': compact }]}
  href={`${baseUrl}#inicio`}
  aria-label="W3TI — início"
>
  <span class="logo__image-wrap">
    <img
      class="logo__image"
      src={`${baseUrl}${siteConfig.logoImage}`}
      alt="W3TI"
      width="1536"
      height="1024"
    />
  </span>
  {compact && <span class="sr-only">W3TI</span>}
</a>
