---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PluginCard from '../components/PluginCard.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TechnologyBadge from '../components/TechnologyBadge.astro';
import { plugins } from '../data/plugins';
import { catalogProducts, developmentProducts, products } from '../data/products';
import { siteConfig } from '../data/site';
import { technologies } from '../data/technologies';

const contactIsConfigured = !siteConfig.contactEmail.startsWith('CONTATO_');
const highlights = [
  { value: products.length.toString(), label: 'produtos no portfólio' },
  { value: catalogProducts.length.toString().padStart(2, '0'), label: 'produtos disponíveis' },
  { value: '03', label: 'plataformas: Linux, Windows e Android' },
  { value: '01', label: 'sistema operacional próprio' },
];
---

<BaseLayout>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <Header />
  <main id="conteudo">
    <section class="hero" id="inicio">
      <div class="container hero__grid">
        <div class="hero__content">
          <p class="eyebrow eyebrow--rule">W3TI · Software que transforma</p>
          <h1>Software feito para resolver problemas reais.</h1>
          <p class="hero__lead">
            Criamos produtos para pessoas, empresas e desenvolvedores — combinando engenharia,
            experiência de uso e inteligência artificial.
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href="#produtos"
              >Conheça nossos produtos <span aria-hidden="true">→</span></a
            >
            <a class="button button--outline" href="#contato">Fale conosco</a>
          </div>
        </div>
        <aside class="hero-panel" aria-label="Destaques do portfólio">
          <p class="hero-panel__title">Portfólio W3TI</p>
          <ul class="hero-panel__list">
            {
              products.slice(0, 4).map((product) => (
                <li class={`hero-panel__item accent--${product.accent}`}>
                  <span class="hero-panel__symbol" aria-hidden="true">
                    {product.symbol}
                  </span>
                  <span>
                    <strong>{product.name}</strong>
                    <small>{product.category}</small>
                  </span>
                  <span class="hero-panel__state">
                    {product.status === 'available' ? 'Disponível' : 'Em desenvolvimento'}
                  </span>
                </li>
              ))
            }
          </ul>
          <a class="text-link" href="#produtos"
            >Ver portfólio completo <span aria-hidden="true">→</span></a
          >
        </aside>
      </div>
      <div class="container">
        <dl class="stats-bar">
          {
            highlights.map((item) => (
              <div class="stats-bar__item">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section section--muted" id="produtos">
      <div class="container">
        <SectionHeader
          eyebrow="O que fazemos"
          title="Produtos que resolvem problemas concretos."
          description="Ferramentas para desenvolvedores, bancos de dados e finanças pessoais — prontas para instalar e usar."
        />
        <div class="product-grid">
          {catalogProducts.map((product) => <ProductCard product={product} />)}
        </div>
      </div>
    </section>

    <section class="section spotlight" id="draco">
      <div class="container spotlight__grid">
        <div class="spotlight__visual" aria-hidden="true">
          <div class="spotlight-window">
            <div class="spotlight-window__bar">
              <span class="spotlight-window__dot spotlight-window__dot--violet"></span>
              <span class="spotlight-window__dot spotlight-window__dot--blue"></span>
              <span class="spotlight-window__dot spotlight-window__dot--green"></span>
              <span>draco / postgres</span>
            </div>
            <div class="draco-workspace">
              <aside class="draco-sidebar">
                <small>SCHEMAS</small>
                <span class="draco-sidebar__active">public</span>
                <span>extensions</span>
                <span>information_schema</span>
                <small>OBJECTS</small>
                <span class="draco-sidebar__muted">▾ tables</span>
                <span class="draco-sidebar__item">users</span>
                <span class="draco-sidebar__item">transactions</span>
              </aside>
              <div class="draco-editor">
                <div class="draco-editor__tabs"><span>query.sql</span><b>▶</b></div>
                <div class="draco-query">
                  <span><i>SELECT</i> id, name, created_at</span>
                  <span><i>FROM</i> public.users</span>
                  <span><i>WHERE</i> active = <em>true</em></span>
                  <span><i>ORDER BY</i> created_at <em>DESC</em>;</span>
                </div>
                <div class="draco-results">
                  <span>RESULTS <b>24 rows</b></span>
                  <div><i>id</i><i>name</i><i>created_at</i></div>
                  <div><b>001</b><b>Maria Costa</b><b>2026-07-28</b></div>
                  <div><b>002</b><b>João Lima</b><b>2026-07-27</b></div>
                </div>
              </div>
            </div>
            <div class="draco-statusbar">
              <span>connected · PostgreSQL</span><span>UTF-8 · 12ms</span>
            </div>
          </div>
        </div>
        <div class="spotlight__content">
          <p class="eyebrow eyebrow--rule">Draco Postgres · gratuito e de código aberto</p>
          <h2>Seu banco de dados, sob controle.</h2>
          <p>
            Explore schemas, escreva SQL, desenhe diagramas e administre bancos PostgreSQL em uma
            ferramenta nativa e rápida para Linux e Windows.
          </p>
          <ol class="feature-list">
            <li><span>01</span> Editor SQL, explorador de schemas e diagramas ER</li>
            <li><span>02</span> Administração, backup e túneis SSH com jump hosts</li>
            <li><span>03</span> Integração com GitHub e senhas guardadas no cofre do sistema</li>
          </ol>
          <div class="spotlight__actions">
            <button
              class="button button--primary"
              type="button"
              data-modal-open="draco-installation"
              aria-controls="draco-installation"
            >
              Como instalar
            </button>
            <a
              class="text-link"
              href="https://dracodb.com.br"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visitar dracodb.com.br <span aria-hidden="true">↗</span><span class="sr-only">
                (abre em nova aba)</span
              >
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--muted spotlight spotlight--reverse" id="openbase">
      <div class="container spotlight__grid">
        <div class="spotlight__visual" aria-hidden="true">
          <div class="spotlight-window openbase-window">
            <div class="spotlight-window__bar">
              <span class="spotlight-window__dot spotlight-window__dot--blue"></span>
              <span class="spotlight-window__dot spotlight-window__dot--violet"></span>
              <span class="spotlight-window__dot spotlight-window__dot--green"></span>
              <span>openbase / api</span>
            </div>
            <div class="openbase-terminal">
              <div><i>❯</i> openbase new -n MyApi -d postgres</div>
              <div class="openbase-terminal__muted">Creating project structure...</div>
              <div class="openbase-terminal__success">✓ Domain</div>
              <div class="openbase-terminal__success">✓ Application</div>
              <div class="openbase-terminal__success">✓ Infrastructure</div>
              <div class="openbase-terminal__success">✓ Presentation</div>
              <div class="openbase-terminal__cursor">
                <i>❯</i> openbase scaffold --entity Product
              </div>
            </div>
            <div class="openbase-layers">
              <span><b>D</b> Domain</span>
              <span><b>A</b> Application</span>
              <span><b>I</b> Infrastructure</span>
              <span><b>P</b> Presentation</span>
            </div>
            <div class="openbase-statusbar">
              <span>OpenBase CLI · ready</span><span>.NET 10 · PostgreSQL</span>
            </div>
          </div>
        </div>
        <div class="spotlight__content">
          <p class="eyebrow eyebrow--rule">OpenBase · ecossistema .NET</p>
          <h2>Do primeiro comando à arquitetura completa.</h2>
          <p>
            Acelere APIs .NET com templates de arquitetura hexagonal, scaffolding e uma extensão
            para VS Code que mantém o fluxo de desenvolvimento perto do código.
          </p>
          <ol class="feature-list">
            <li><span>01</span> CLI global com build, run e criação de projetos</li>
            <li><span>02</span> Template único com o adaptador de banco escolhido na criação</li>
            <li><span>03</span> Scaffolding de entidades para SQL Server, PostgreSQL e Oracle</li>
          </ol>
          <div class="spotlight__actions">
            <button
              class="button button--primary"
              type="button"
              data-modal-open="openbase-installation"
              aria-controls="openbase-installation"
            >
              Como instalar
            </button>
            <a
              class="text-link"
              href="https://github.com/britors/OpenBase.CLI"
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver no GitHub <span aria-hidden="true">↗</span><span class="sr-only">
                (abre em nova aba)</span
              >
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="em-desenvolvimento">
      <div class="container">
        <SectionHeader
          eyebrow="Próximos capítulos"
          title="Produtos em desenvolvimento."
          description="Mostramos o que ainda está ganhando forma para construir uma relação transparente com quem acompanha a W3TI."
        />
        <ol class="pipeline-list">
          {
            developmentProducts.map((product, index) => (
              <li class={`pipeline-list__item accent--${product.accent}`}>
                <span class="pipeline-list__index">{(index + 1).toString().padStart(2, '0')}</span>
                <div class="pipeline-list__body">
                  <h3>{product.name}</h3>
                  <p>{product.summary}</p>
                </div>
                {product.technologies && (
                  <ul class="tag-list" aria-label={`Tecnologias relacionadas a ${product.name}`}>
                    {product.technologies.map((technology) => (
                      <li>{technology}</li>
                    ))}
                  </ul>
                )}
                {product.url ? (
                  <a
                    class="pipeline-list__link"
                    href={product.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Acompanhar <span aria-hidden="true">↗</span>
                    <span class="sr-only"> {product.name} (abre em nova aba)</span>
                  </a>
                ) : (
                  <span class="pipeline-list__link pipeline-list__link--muted">Em breve</span>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section section--muted" id="lyra">
      <div class="container lyra">
        <div class="lyra__visual" aria-hidden="true">
          <div class="lyra-orbit lyra-orbit--one"></div>
          <div class="lyra-orbit lyra-orbit--two"></div>
          <div class="lyra-core"><span>LYRA</span><small>OS</small></div>
        </div>
        <div class="lyra__content">
          <p class="eyebrow eyebrow--rule">Ecossistema Lyra · Linux</p>
          <h2>Conheça também o Lyra OS.</h2>
          <p>
            Sistema operacional baseado no openSUSE Leap 16, com edições Desktop (GNOME) e Server.
            Inclui o Vega, centro de controle do sistema, e aplicativos próprios como o cliente SSH
            Sulafat e o cliente RDP Beam.
          </p>
          <a
            class="button button--primary"
            href={siteConfig.lyraUrl}
            target="_blank"
            rel="noopener noreferrer"
            >Visitar lyraos.com.br <span aria-hidden="true">↗</span><span class="sr-only">
              (abre em nova aba)</span
            ></a
          >
        </div>
      </div>
    </section>

    <section class="section" id="engenharia">
      <div class="container engineering">
        <SectionHeader
          eyebrow="Como fazemos"
          title="Engenharia orientada a produtos."
          description="Escolhemos tecnologias de acordo com o problema que cada produto precisa resolver: aplicações desktop, ferramentas de banco de dados, sistemas empresariais e o ecossistema Linux."
        />
        <ul class="technology-grid">
          {technologies.map((technology) => <TechnologyBadge technology={technology} />)}
        </ul>
      </div>
    </section>

    <section class="section section--muted" id="empresa">
      <div class="container company">
        <div>
          <p class="eyebrow eyebrow--rule">Sobre a W3TI</p>
          <blockquote class="company__quote">
            Transformar problemas complexos em experiências simples, claras e confiáveis.
          </blockquote>
        </div>
        <div class="company__copy">
          <p>
            A W3TI é uma empresa brasileira que desenvolve produtos de software para diferentes
            áreas, sempre com a mesma preocupação: qualidade de engenharia e respeito a quem usa.
          </p>
          <p>
            Nosso trabalho reúne aplicações pessoais, ferramentas para desenvolvedores, sistemas
            empresariais, jogos e o ecossistema Linux do Lyra OS.
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="plugins">
      <div class="container">
        <SectionHeader
          eyebrow="Plugins para Claude Code"
          title="Plugins que deixam o Claude Code mais econômico e confiável."
          description="Plugins gratuitos e de código aberto para o Claude Code, o assistente de programação da Anthropic. Cada um resolve um problema do dia a dia: custo de tokens, contexto, escopo, commits, revisão de texto e orçamentos."
        />
        <div class="product-grid plugin-grid">
          {plugins.map((plugin) => <PluginCard plugin={plugin} />)}
        </div>
        <p class="plugin-note">
          Os plugins funcionam no Claude Code 2.1.275 ou mais novo. Os que usam hooks precisam de
          <code>python3</code> no PATH. Em versões anteriores, adicione o marketplace com
          <code>/plugin marketplace add britors/&lt;plugin&gt;</code> e instale com
          <code>/plugin install &lt;plugin&gt;@&lt;plugin&gt;</code>.
        </p>
      </div>
    </section>

    <section class="cta-band" id="contato">
      <div class="container cta-band__inner">
        <div>
          <p class="eyebrow eyebrow--light">Vamos conversar</p>
          <h2>Tem um problema para resolver?</h2>
          <p>
            Conte um pouco sobre o que você está construindo, usando ou procurando. A W3TI está
            sempre aberta a boas conversas.
          </p>
        </div>
        <div class="cta-band__actions">
          {
            contactIsConfigured ? (
              <a class="button button--light" href={`mailto:${siteConfig.contactEmail}`}>
                Entrar em contato <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="button button--disabled" aria-disabled="true">
                E-mail em configuração
              </span>
            )
          }
          <a
            class="text-link text-link--light"
            href={siteConfig.githubUrl}
            target="_blank"
            rel="noopener noreferrer">Acompanhe no GitHub <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>
  </main>

  <dialog class="install-modal" id="draco-installation" aria-labelledby="draco-installation-title">
    <div class="install-modal__panel">
      <div class="install-modal__header">
        <div>
          <p class="eyebrow eyebrow--violet">Draco Postgres · Windows e Linux</p>
          <h2 id="draco-installation-title">Consulte seus dados com clareza.</h2>
        </div>
        <button
          class="install-modal__close"
          type="button"
          data-modal-close
          aria-label="Fechar instruções"
        >
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <p class="install-modal__intro">
        Escolha o instalador correspondente ao seu sistema ou compile a versão nativa em Rust a
        partir do código-fonte. Os pacotes são destinados a computadores de 64 bits. Instruções
        completas estão em <a
          href="https://dracodb.com.br"
          target="_blank"
          rel="noopener noreferrer">dracodb.com.br</a
        >.
      </p>
      <div class="install-download install-download--violet">
        <div>
          <span class="install-download__label">Windows</span>
          <small>Instalador x86_64 / amd64 · arquivo .exe</small>
        </div>
        <a
          class="button button--primary"
          id="draco-windows-download"
          href="https://github.com/britors/Draco/releases/download/v2.2.1/Draco_2.2.1_windows_x64-setup.exe"
          download
        >
          Baixar .exe <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="install-download install-download--violet">
        <div>
          <span class="install-download__label">Ubuntu / Debian</span>
          <small>Pacote x86_64 · arquivo .deb · gerado no Ubuntu 24.04</small>
        </div>
        <a
          class="button button--primary"
          id="draco-deb-download"
          href="https://github.com/britors/Draco/releases/download/v2.2.1/draco_2.2.1_ubuntu24.04_amd64.deb"
          download
        >
          Baixar .deb <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="install-download install-download--violet">
        <div>
          <span class="install-download__label">Fedora</span>
          <small>Pacote x86_64 · arquivo .rpm · Fedora 43</small>
        </div>
        <a
          class="button button--primary"
          id="draco-fedora-download"
          href="https://github.com/britors/Draco/releases/download/v2.2.1/draco_2.2.1_fedora43_x86_64.rpm"
          download
        >
          Baixar .rpm <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="install-download install-download--violet">
        <div>
          <span class="install-download__label">openSUSE</span>
          <small>Pacote x86_64 · arquivo .rpm · openSUSE Leap 16</small>
        </div>
        <a
          class="button button--primary"
          id="draco-opensuse-download"
          href="https://github.com/britors/Draco/releases/download/v2.2.1/draco_2.2.1_opensuse-leap16.0_x86_64.rpm"
          download
        >
          Baixar .rpm <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="install-download__note">
        Os botões acompanham automaticamente os pacotes da release mais recente. Se o download não
        começar, <a
          href="https://github.com/britors/Draco/releases/latest"
          target="_blank"
          rel="noopener noreferrer">abra a página de releases</a
        >.
      </p>
      <div class="install-steps">
        <article>
          <span class="install-step__number">01</span>
          <h3>Windows</h3>
          <p>Baixe o `.exe`, abra o instalador e siga as instruções na tela.</p>
        </article>
        <article>
          <span class="install-step__number">02</span>
          <h3>Ubuntu / Debian</h3>
          <p>
            Baixe o `.deb` e instale com <code
              >sudo apt install ./draco_versao_ubuntu24.04_amd64.deb</code
            >.
          </p>
        </article>
        <article>
          <span class="install-step__number">03</span>
          <h3>Fedora / openSUSE</h3>
          <p>
            Use o `.rpm` da sua distribuição com <code
              >sudo dnf install ./draco_versao_fedora43_x86_64.rpm</code
            > ou <code>sudo zypper install ./draco_versao_opensuse-leap16.0_x86_64.rpm</code>.
          </p>
        </article>
        <article>
          <span class="install-step__number">04</span>
          <h3>Compilar do código</h3>
          <p>
            Instale Rust 1.85 ou superior e as dependências de sistema. Execute <code
              >cargo build --locked --release -p draco-tauri</code
            > e rode <code>./target/release/draco</code>.
          </p>
        </article>
      </div>
      <div class="install-modal__footer">
        <span>Cliente PostgreSQL gratuito e de código aberto, feito com Rust e Tauri.</span>
        <a
          class="text-link"
          href="https://github.com/britors/Draco"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ler documentação <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </dialog>
  <dialog
    class="install-modal"
    id="openbase-installation"
    aria-labelledby="openbase-installation-title"
  >
    <div class="install-modal__panel">
      <div class="install-modal__header">
        <div>
          <p class="eyebrow eyebrow--blue">OpenBase · ferramentas .NET</p>
          <h2 id="openbase-installation-title">Comece a construir com OpenBase.</h2>
        </div>
        <button
          class="install-modal__close"
          type="button"
          data-modal-close
          aria-label="Fechar instruções"
        >
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <p class="install-modal__intro">
        O OpenBase funciona em duas partes: a extensão para integrar o fluxo ao VS Code e o CLI
        global do .NET para criar projetos, instalar templates e gerar camadas da aplicação.
      </p>
      <div class="install-download install-download--blue">
        <div>
          <span class="install-download__label">Extensão para VS Code</span>
          <small>OpenBase CLI · comandos e acesso rápido no editor</small>
        </div>
        <a
          class="button button--primary"
          href="https://marketplace.visualstudio.com/items?itemName=RodrigoSoaresdeBrito.openbase"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instalar extensão <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="install-download install-download--blue">
        <div>
          <span class="install-download__label">CLI global do .NET</span>
          <small>Pacote NuGet · w3ti.OpenBase.CLI</small>
        </div>
        <a
          class="button button--primary"
          href="https://www.nuget.org/packages/w3ti.OpenBase.CLI"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver no NuGet <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="install-steps">
        <article>
          <span class="install-step__number">01</span>
          <h3>Prepare o ambiente</h3>
          <p>
            Instale o .NET SDK 10 e confirme a versão com <code>dotnet --version</code>.
          </p>
        </article>
        <article>
          <span class="install-step__number">02</span>
          <h3>Instale o CLI</h3>
          <p>
            Instale a ferramenta global com <code>dotnet tool install -g w3ti.OpenBase.Cli</code>.
            Para atualizar depois, use <code>dotnet tool update -g w3ti.OpenBase.Cli</code>.
          </p>
        </article>
        <article>
          <span class="install-step__number">03</span>
          <h3>Adicione os templates</h3>
          <p>Execute <code>openbase install</code> para instalar os templates do ecossistema.</p>
        </article>
        <article>
          <span class="install-step__number">04</span>
          <h3>Crie e gere o projeto</h3>
          <p>
            Use <code>openbase new -n MeuProjeto -d postgres</code> (ou <code>sqlserver</code>,
            <code>oracle</code>) e depois <code>openbase scaffold --entity Product</code>.
          </p>
        </article>
      </div>
      <div class="install-modal__footer">
        <span
          >O CLI também oferece <code>build</code>, <code>run</code> e scaffolding de entidades.</span
        >
        <a
          class="text-link"
          href="https://github.com/britors/OpenBase.CLI"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ler documentação <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </dialog>
  <dialog class="install-modal" id="fina-installation" aria-labelledby="fina-installation-title">
    <div class="install-modal__panel">
      <div class="install-modal__header">
        <div>
          <p class="eyebrow eyebrow--green">Fina · finanças pessoais</p>
          <h2 id="fina-installation-title">Organize sua vida financeira.</h2>
        </div>
        <button
          class="install-modal__close"
          type="button"
          data-modal-close
          aria-label="Fechar instruções"
        >
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <p class="install-modal__intro">
        Escolha o caminho correspondente ao seu sistema. As versões para Windows e Linux são para
        computadores de 64 bits; seus dados ficam armazenados localmente no computador.
      </p>
      <div class="install-download install-download--green">
        <div>
          <span class="install-download__label">Windows 10 e 11</span>
          <small>Instalador x86_64 / amd64 · arquivo .exe</small>
        </div>
        <a
          class="button button--primary"
          id="fina-windows-download"
          href="https://github.com/w3ti/Fina/releases/download/v18.6.0/Fina-Setup-18.6.0.exe"
          download
        >
          Baixar .exe <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="install-download install-download--green">
        <div>
          <span class="install-download__label">Ubuntu / Debian</span>
          <small>Pacote x86_64 / amd64 · arquivo .deb</small>
        </div>
        <a
          class="button button--primary"
          id="fina-deb-download"
          href="https://github.com/w3ti/Fina/releases/download/v18.6.0/fina_18.6.0_amd64.deb"
          download
        >
          Baixar .deb <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="install-download install-download--green">
        <div>
          <span class="install-download__label">Fedora / openSUSE</span>
          <small>Pacote x86_64 · arquivo .rpm</small>
        </div>
        <a
          class="button button--primary"
          id="fina-rpm-download"
          href="https://github.com/w3ti/Fina/releases/download/v18.6.0/fina-18.6.0.x86_64.rpm"
          download
        >
          Baixar .rpm <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="install-download__note">
        Os botões acompanham automaticamente os pacotes da release mais recente. Se o download não
        começar, <a
          href="https://github.com/w3ti/Fina/releases/latest"
          target="_blank"
          rel="noopener noreferrer">abra a página de releases</a
        >.
      </p>
      <div class="install-steps">
        <article>
          <span class="install-step__number">01</span>
          <h3>Windows</h3>
          <p>
            Baixe o instalador, abra o arquivo e siga as instruções na tela. Depois, inicie o Fina
            pelo menu Iniciar.
          </p>
        </article>
        <article>
          <span class="install-step__number">02</span>
          <h3>Ubuntu / Debian</h3>
          <p>
            Baixe o `.deb` e instale com <code>sudo apt install ./fina_versao_amd64.deb</code>.
          </p>
        </article>
        <article>
          <span class="install-step__number">03</span>
          <h3>Fedora / openSUSE</h3>
          <p>
            Baixe o `.rpm` e instale com <code>sudo dnf install ./fina-versao.x86_64.rpm</code> ou
            <code>sudo zypper install ./fina-versao.x86_64.rpm</code>.
          </p>
        </article>
        <article>
          <span class="install-step__number">04</span>
          <h3>Site oficial</h3>
          <p>
            Veja novidades, recursos e outras formas de instalação em <a
              href="https://fina.net.br"
              target="_blank"
              rel="noopener noreferrer">fina.net.br</a
            >.
          </p>
        </article>
      </div>
      <div class="install-modal__footer">
        <span
          >Os dados locais são preservados ao desinstalar. Linux: <code>~/.config/Fina</code> · Windows:
          <code>%APPDATA%\Fina</code>.</span
        >
        <a
          class="text-link"
          href="https://github.com/w3ti/Fina#readme"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ler documentação <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </dialog>
  <Footer />
</BaseLayout>

<script>
  const finaWindowsDownload = document.querySelector<HTMLAnchorElement>('#fina-windows-download');
  const finaDebDownload = document.querySelector<HTMLAnchorElement>('#fina-deb-download');
  const finaRpmDownload = document.querySelector<HTMLAnchorElement>('#fina-rpm-download');
  const dracoWindowsDownload = document.querySelector<HTMLAnchorElement>('#draco-windows-download');
  const dracoDebDownload = document.querySelector<HTMLAnchorElement>('#draco-deb-download');
  const dracoFedoraDownload = document.querySelector<HTMLAnchorElement>('#draco-fedora-download');
  const dracoOpensuseDownload = document.querySelector<HTMLAnchorElement>(
    '#draco-opensuse-download',
  );

  document.querySelectorAll<HTMLButtonElement>('[data-modal-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const modalId = trigger.dataset.modalOpen;
      const modal = modalId ? document.getElementById(modalId) : null;

      if (modal instanceof HTMLDialogElement && !modal.open) {
        modal.showModal();
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-modal-close]').forEach((closeButton) => {
    closeButton.addEventListener('click', () => {
      const modal = closeButton.closest('dialog');
      modal?.close();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('.install-modal').forEach((modal) => {
    modal.addEventListener('click', (event) => {
      if (event.target === modal) {
        modal.close();
      }
    });
  });

  if (finaWindowsDownload || finaDebDownload || finaRpmDownload) {
    fetch('https://api.github.com/repos/w3ti/Fina/releases/latest', {
      headers: { Accept: 'application/vnd.github+json' },
    })
      .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
      .then((release) => {
        const windowsAsset = release.assets?.find(
          (asset: { name?: string; browser_download_url?: string }) =>
            /^Fina-Setup-.*\.exe$/i.test(asset.name ?? ''),
        );
        const debAsset = release.assets?.find(
          (asset: { name?: string; browser_download_url?: string }) =>
            /\.deb$/i.test(asset.name ?? ''),
        );
        const rpmAsset = release.assets?.find(
          (asset: { name?: string; browser_download_url?: string }) =>
            /^fina-(?!latest).*\.rpm$/i.test(asset.name ?? ''),
        );

        if (windowsAsset?.browser_download_url && finaWindowsDownload) {
          finaWindowsDownload.href = windowsAsset.browser_download_url;
        }
        if (debAsset?.browser_download_url && finaDebDownload) {
          finaDebDownload.href = debAsset.browser_download_url;
        }
        if (rpmAsset?.browser_download_url && finaRpmDownload) {
          finaRpmDownload.href = rpmAsset.browser_download_url;
        }
      })
      .catch(() => {
        // Os links da release atual permanecem como fallback se a API estiver indisponível.
      });
  }

  if (dracoWindowsDownload || dracoDebDownload || dracoFedoraDownload || dracoOpensuseDownload) {
    fetch('https://api.github.com/repos/britors/Draco/releases/latest', {
      headers: { Accept: 'application/vnd.github+json' },
    })
      .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
      .then((release) => {
        const windowsAsset = release.assets?.find(
          (asset: { name?: string; browser_download_url?: string }) =>
            /\.exe$/i.test(asset.name ?? ''),
        );
        const debAsset = release.assets?.find(
          (asset: { name?: string; browser_download_url?: string }) =>
            /\.deb$/i.test(asset.name ?? ''),
        );
        const fedoraAsset = release.assets?.find(
          (asset: { name?: string; browser_download_url?: string }) =>
            /fedora.*\.rpm$/i.test(asset.name ?? ''),
        );
        const opensuseAsset = release.assets?.find(
          (asset: { name?: string; browser_download_url?: string }) =>
            /opensuse.*\.rpm$/i.test(asset.name ?? ''),
        );

        if (windowsAsset?.browser_download_url && dracoWindowsDownload) {
          dracoWindowsDownload.href = windowsAsset.browser_download_url;
        }
        if (debAsset?.browser_download_url && dracoDebDownload) {
          dracoDebDownload.href = debAsset.browser_download_url;
        }
        if (fedoraAsset?.browser_download_url && dracoFedoraDownload) {
          dracoFedoraDownload.href = fedoraAsset.browser_download_url;
        }
        if (opensuseAsset?.browser_download_url && dracoOpensuseDownload) {
          dracoOpensuseDownload.href = opensuseAsset.browser_download_url;
        }
      })
      .catch(() => {
        // Os links da release atual permanecem como fallback se a API estiver indisponível.
      });
  }
</script>
